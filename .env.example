# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# Google Analytics (GA4 Measurement ID, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console HTML tag verification content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Daily offer discovery (Vercel Cron)
# Generate: openssl rand -hex 32
CRON_SECRET=""
# Optional — Eventbrite free events in UK cities (https://www.eventbrite.com/platform/api)
EVENTBRITE_API_TOKEN=""
# Optional — extra RSS feeds, comma-separated URLs
DISCOVERY_RSS_FEEDS=""
